+void ScriptEngine::dispatchCursorEvents () {
+    const auto width = static_cast<float> (this->m_scene.getWidth ());
+    const auto height = static_cast<float> (this->m_scene.getHeight ());
+    const glm::vec2* normalized = this->m_scene.getMousePositionNormalized ();
+    // objects are placed in coordinates centered on the scene with Y pointing down, the pointer comes as
+    // fractions of the scene with Y pointing up
+    const glm::vec2 point ((normalized->x - 0.5f) * width, height / 2.0f - normalized->y * height);
+    const bool down = this->m_scene.getContext ().getInputContext ().getMouseInput ().leftClick ()
+	== Input::MouseClickStatus::Clicked;
+    const bool pressed = down && !this->m_cursorWasDown;
+    const bool released = !down && this->m_cursorWasDown;
+    const bool moved = point != this->m_cursorLastPoint;
+
+    this->m_cursorWasDown = down;
+    this->m_cursorLastPoint = point;
+
+    // work out what happened to each layer once, however many scripts it has
+    struct Transition {
+	bool entered, left, down, moved, up, click;
+    };
+    std::map<ScriptableObject*, Transition> transitions;
+
+    for (auto& module : this->m_scriptModules | std::views::values) {
+	ScriptableObject* object = module.object;
+
+	if (object == nullptr || transitions.contains (object)) {
+	    continue;
+	}
+
+	const auto& properties = object->getProperties ();
+	const auto visible = properties.find ("visible");
+	// a visibility driven by a script may not hold a boolean (yet)
+	const bool shown = visible == properties.end ()
+	    || visible->second.value.getType () != DynamicValue::Boolean || visible->second.value.getBool ();
+	const bool inside = shown && object->containsScenePoint (point);
+	CursorState& state = this->m_cursorStates[object];
+
+	transitions[object] = {
+	    .entered = inside && !state.hovered,
+	    .left = !inside && state.hovered,
+	    .down = pressed && inside,
+	    .moved = moved && (inside || state.pressed),
+	    .up = released && state.pressed,
+	    .click = released && state.pressed && inside,
+	};
+
+	state.hovered = inside;
+	if (pressed) {
+	    state.pressed = inside;
+	} else if (released) {
+	    state.pressed = false;
+	}
+    }
+
+    JSContext* ctx = this->m_context;
+    JSValue event = JS_NewObject (ctx);
+    JSValue worldPosition = this->m_adapters.vec3->instantiate ();
+    JS_SetPropertyStr (ctx, worldPosition, "x", JS_NewFloat64 (ctx, normalized->x * width));
+    JS_SetPropertyStr (ctx, worldPosition, "y", JS_NewFloat64 (ctx, normalized->y * height));
+    JS_SetPropertyStr (ctx, worldPosition, "z", JS_NewFloat64 (ctx, 0.0));
+    JS_SetPropertyStr (ctx, event, "worldPosition", worldPosition);
+
+    for (auto& module : this->m_scriptModules | std::views::values) {
+	const auto it = module.object != nullptr ? transitions.find (module.object) : transitions.end ();
+
+	if (it == transitions.end ()) {
+	    continue;
+	}
+
+	const Transition& transition = it->second;
+	const std::pair<bool, const char*> handlers[] = {
+	    { transition.entered, "cursorEnter" }, { transition.left, "cursorLeave" },
+	    { transition.down, "cursorDown" },	   { transition.moved, "cursorMove" },
+	    { transition.up, "cursorUp" },	   { transition.click, "cursorClick" },
+	};
+
+	for (const auto& [happened, name] : handlers) {
+	    if (!happened) {
+		continue;
+	    }
+
+	    this->enter (module);
+	    JSValue args[] = { event };
+	    JSValue result = this->call (module.module, 1, args, name);
+
+	    if (JS_IsException (result)) {
+		this->report (module, name);
+	    }
+
+	    JS_FreeValue (ctx, result);
+	}
+    }
+
+    JS_FreeValue (ctx, event);
 }
 
